#contact.scrollspy.section__contact
  .contact__hero
    .contact__bg-orb.contact__bg-orb--1
    .contact__bg-orb.contact__bg-orb--2
    .contact__bg-grid

    .container
      .contact__header.reveal
        %span.eyebrow {% t site.contact.title %}
        %h2.contact__title {% t site.contact.cta-title %}
        %p.contact__lead {% t site.contact.lead %}

      .contact__main.reveal
        .contact__email-card
          .contact__email-glow
          %span.contact__email-label {% t site.contact.cta-title %}
          %a.contact__email-link{href: "mailto:transport@weasels.co"}
            %span.contact__email-text transport@weasels.co
            %i.material-icons.contact__email-icon arrow_outward
          %p.contact__email-note {% t site.contact.cta-lead %}

          .contact__actions
            %a.btn-magnetic.btn-magnetic--primary{href: "mailto:transport@weasels.co"}
              %i.material-icons mail_outline
              %span {% t site.contact.cta-btn %}
            %a.btn-magnetic.btn-magnetic--ghost{href: "tel:+48727907796"}
              %i.material-icons call
              %span {% t site.contact.cta-call %}

        .contact__info-grid
          .contact__info-card
            %i.material-icons.contact__info-icon schedule
            %h4 {% t site.contact.hours-title %}
            %p {% t site.contact.hours %}
          .contact__info-card
            %i.material-icons.contact__info-icon bolt
            %h4 {% t site.contact.response-title %}
            %p {% t site.contact.response %}
          .contact__info-card
            %i.material-icons.contact__info-icon phone_in_talk
            %h4 {% t site.contact.maciej.tel %}
            %p {% t site.contact.maciej.title %}

      .contact__people.reveal
        .contact__person
          .contact__person--photo
            %img{src: "images/contact/maciej1.webp", alt: 'Maciej Łasecki — spedycja Weasels Sp. z o.o.', loading: 'lazy', decoding: 'async', width: '480', height: '480'}
            .contact__person--overlay
          .contact__person--info
            %div
              %span.contact__person--role Prezes
              %h3.contact__person--name {% t site.contact.maciej.title %}
            .contact__person--links
              %a{href: "mailto:maciej.lasecki@weasels.co"}
                %i.material-icons mail_outline
                %span {% t site.contact.maciej.mail %}
              %a{href: "tel:+48727907796"}
                %i.material-icons call
                %span {% t site.contact.maciej.tel %}

        .contact__person
          .contact__person--photo
            %img{src: "images/contact/michal.webp", alt: 'Michał Łasecki — zarząd Weasels Sp. z o.o.', loading: 'lazy', decoding: 'async', width: '480', height: '480'}
            .contact__person--overlay
          .contact__person--info
            %div
              %span.contact__person--role Zarząd
              %h3.contact__person--name {% t site.contact.michal.title %}
            .contact__person--links
              %a{href: "mailto:michal.lasecki@weasels.co"}
                %i.material-icons mail_outline
                %span {% t site.contact.michal.mail %}
              %a{href: "tel:+48726922069"}
                %i.material-icons call
                %span {% t site.contact.michal.tel %}

