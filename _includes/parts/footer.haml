.section__footer--block.midnight
  .footer-cta
    %span.eyebrow.footer-cta__eyebrow Współpraca
    %h3.center.grey-text.text-lighten-3.text-bold.section__gallery--title.footer-cta__title
      {% t site.footer.title %}
    %p.footer-cta__lead {% t site.contact.lead-2 %}
    %a.btn-magnetic.btn-magnetic--primary.footer-cta__btn{href: "#contact"}
      %i.material-icons mail_outline
      %span {% t site.contact.cta-btn %}

%footer.page-footer.white.section__footer
  .container
    .row
      .col.l7.s12.about-company
        %h4.grey-text.text-darken-3.text-bold.text-upcase {% t site.footer.table.name %}
        %p.black-text.text-lighten-4 {% t site.about.lead %}
        %p.black-text.text-lighten-4 {% t site.footer.about %}

      .col.l5.s12
        %h4.grey-text.text-darken-3.text-bold.text-upcase {% t site.footer.table.title %}
        %table.about-table.black-text
          %tbody
            %tr
              %td
                %span.right.text-bold NIP
              %td
                %span PL 766 199 52 94
            %tr
              %td
                %span.right.text-bold Regon
              %td
                %span 365359540
            %tr
              %td
                %span.right.text-bold KRS
              %td
                %span 0000635743
            %tr
              %td
                %span.right.text-bold {% t site.footer.table.activity %}
              %td
                %span {% t site.footer.table.type %} (PKD : 49.41.Z)
            %tr
              %td
                %span.right.text-bold {% t site.footer.table.address %}
              %td
                %span Rakojedzka 32H, 62-085 Skoki, Polska
            %tr
              %td
                %span.right.text-bold {% t site.footer.table.base %}
              %td
                %span Orzechowa 1, 62-100 Wągrowiec, Polska
  .footer-copyright
    .container.black-text
      .footer-copyright__line
        %span {{ site.time | date: '%Y' }} © Weasels. Wszelkie prawa zastrzeżone. Made by Michał Łasecki
        .footer-copyright__links
          %a.footer-copyright__link{href: "/polityka-prywatnosci/"} Polityka prywatności
          %a.footer-copyright__link{href: "/polityka-cookies/"} Polityka cookies
          %a.footer-copyright__link{href: "#", "data-cookie-action" => "manage"} Zarządzaj cookies
